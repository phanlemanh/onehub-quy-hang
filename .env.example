# Postgres của Quỹ hàng — dự án riêng, KHÔNG dùng chung với OneHub Invest (ADR-0001).
# Local: docker run --rm -d --name quy-hang-db -e POSTGRES_PASSWORD=quyhang -p 5544:5432 postgres:16
DATABASE_URL=postgres://postgres:quyhang@localhost:5544/postgres

# Đăng nhập (ADR-0003). Chuỗi bí mật ngẫu nhiên ≥ 32 ký tự; URL là gốc của app đang chạy.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3460
# Gửi mã đăng nhập qua Resend (ADR-0009). Vắng khoá: máy dev in mã ra nhật ký; bản thật không khởi động (ADR-0005 §7).
# MAIL_FROM phải thuộc tên miền đã xác minh ở Resend.
RESEND_API_KEY=
MAIL_FROM=
# Môi trường thật: DATABASE_URL là pooler phiên của Supabase, đăng nhập bằng vai quy_hang_owner, thêm
# ?sslmode=require&uselibpqcompat=true. Giá trị chỉ nằm ở Vercel và secret của GitHub (environment production).
# Lệnh cơ sở dữ liệu (db:migrate, db:test, van-hanh:mo-san) tự đọc .env.local ở gốc kho khi có; biến đặt sẵn trong môi trường thắng.
