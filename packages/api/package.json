{
  "name": "@quy-hang/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:db": "node --env-file-if-exists=../../.env.local --import tsx --test --test-concurrency=1 --test-reporter=spec \"test-db/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.0",
    "@quy-hang/connect": "*",
    "@quy-hang/core": "*",
    "better-auth": "^1.7.14",
    "hono": "^4.6.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "web-push": "3.6.x",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4"
  }
}
