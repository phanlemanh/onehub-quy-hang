{
  "name": "onehub-quy-hang",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @quy-hang/web",
    "build": "npm run build -w @quy-hang/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate -w @quy-hang/db",
    "db:test": "npm run test:isolation -w @quy-hang/db"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
