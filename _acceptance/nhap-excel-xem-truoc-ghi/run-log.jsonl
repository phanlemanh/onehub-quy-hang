"{\"ts\":\"2026-11-03T16:01:20Z\",\"sha\":\"fa542268cbdbb20ddf3d712a05a65f29ab06057f\",\"round\":2,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/store.ts\",\"title\":\"Create path silently drops owner phone and floor price when the row has no owner name\",\"severity\":\"medium\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu một dòng trong file có số chủ nhà hoặc giá đáy nhưng ô tên chủ để trống, số và giá đó không được lưu và người nhập không được báo. Với căn cập nhật, thông tin chủ nhà trong file cũng không được ghi.\",\"can_cu\":\"Không mất dữ liệu gốc vì file vẫn còn, người nhập thêm lại được bằng tay, và hàng vẫn tạo đúng; sửa là việc của một đợt riêng.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-03T16:01:20Z\",\"sha\":\"fa542268cbdbb20ddf3d712a05a65f29ab06057f\",\"round\":2,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/store.ts\",\"title\":\"Row counted as 'supplement' (sent a supplementary message) even though no lead was created\",\"severity\":\"medium\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Một dòng thiếu số điện thoại hay giá vẫn được đếm vào số tin bổ sung đã gửi, dù thực tế không có tin nào được gửi đi. Con số tổng có thể cao hơn số tin thật.\",\"can_cu\":\"Chỉ lệch con số tổng, lý do vẫn hiện ở từng dòng, không mất dữ liệu và không ai nhận nhầm tin; hợp đồng đã chủ ý để như vậy.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-03T16:01:20Z\",\"sha\":\"fa542268cbdbb20ddf3d712a05a65f29ab06057f\",\"round\":2,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/store.ts\",\"title\":\"'Today' is taken as the UTC date, so the 00:00-07:00 window (Vietnam time) rejects confirmation dates of today\",\"severity\":\"low\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu nhập file trong khoảng 0 giờ đến 7 giờ sáng giờ Việt Nam, ngày xác nhận là hôm nay bị coi là ngày tương lai nên không được ghi. Người nhập phải nhập lại vào buổi sáng hoặc để người xử lý ô đó.\",\"can_cu\":\"Chỉ xảy ra trong 7 giờ đầu ngày, lỗi được báo rõ chứ không ghi sai, và người dùng thử lại sau 7 giờ là xong.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-03T16:01:20Z\",\"sha\":\"fa542268cbdbb20ddf3d712a05a65f29ab06057f\",\"round\":2,\"kind\":\"finding\",\"file\":\"packages/api/test-db/imports/lan-nhap.test.ts\",\"title\":\"Hình 4 — assertion âm-tính-một-mình: đếm import_rows = 0 sau gói 201 dòng chạy ở chế độ xem thử, nên lúc nào cũng đúng\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Bài kiểm tự động cho gói quá 200 dòng có một phép đếm luôn đúng nên không chứng minh được gói bị từ chối thì không ghi gì. Việc từ chối gói quá cỡ vẫn được kiểm bằng mã lỗi.\",\"can_cu\":\"Người dùng không bị ảnh hưởng trực tiếp, vì mã từ chối vẫn được kiểm; sửa sau rẻ và không gây mất dữ liệu.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
