"{\"ts\":\"2026-11-03T15:52:49Z\",\"sha\":\"0ea5efa8fc5728cdcf7332e8961a3124a7b79631\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/store.ts\",\"title\":\"Opening an import checks the plan against headers only, so a phone column the header doesn't reveal can save its value map (raw owner numbers) in imports.plan\",\"severity\":\"high\",\"source\":\"conventions\",\"inContract\":true,\"acRef\":\"AC-7\",\"plain\":\"\",\"can_cu\":\"\",\"proposal\":\"\",\"khongBacBo\":false,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-03T15:52:49Z\",\"sha\":\"0ea5efa8fc5728cdcf7332e8961a3124a7b79631\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/core/src/listing/events.ts\",\"title\":\"The public listing command route now takes owner_confirmed.confirmedAt without the 2-year floor that only the import path applies\",\"severity\":\"low\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Người dùng gửi lệnh xác nhận trực tiếp có thể đặt ngày xác nhận rất cũ, khiến căn trông cũ hơn thực tế. Đường nhập file vẫn áp mốc hai năm nên hai cửa xử lý khác nhau.\",\"can_cu\":\"Chỉ làm căn trông kém tươi hơn, không mất hay lộ dữ liệu, và người dùng tự xác nhận lại để sửa được.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-03T15:52:49Z\",\"sha\":\"0ea5efa8fc5728cdcf7332e8961a3124a7b79631\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/core/src/import/plan.ts\",\"title\":\"Plan is checked at open with no rows, then re-checked per batch using that batch's cell values, so the same plan can pass one batch and be refused for another\",\"severity\":\"medium\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Một lần nhập nhiều gói có thể đang ghi thì một gói cuối bị từ chối vì ô ghi chú có số điện thoại, dù các gói trước đã ghi xong. Người nhập phải xử lý phần còn lại.\",\"can_cu\":\"Không mất hay lộ dữ liệu, gói bị từ chối có thông báo rõ và gửi lại sau khi chỉnh được; chỉ gây phiền ở trường hợp hiếm.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-03T15:52:49Z\",\"sha\":\"0ea5efa8fc5728cdcf7332e8961a3124a7b79631\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/store.ts\",\"title\":\"'Today' is taken in UTC, so a confirmation dated today in Vietnam between 00:00 and 07:00 is refused as a future date\",\"severity\":\"low\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Trong khoảng 0 giờ đến 7 giờ sáng giờ Việt Nam, ngày xác nhận là hôm nay bị coi là ngày tương lai và bị bỏ qua. Căn vẫn được nhập nhưng chưa được tính là đã xác nhận.\",\"can_cu\":\"Chỉ xảy ra vài giờ đầu ngày, không mất dữ liệu, và nhập lại sau 7 giờ là xong.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
