"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/db/migrations/021_lien_he_khach.sql\",\"title\":\"Database functions for creating a share and recording interest still accept removed (voided) units\",\"severity\":\"medium\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Căn đã được hoàn tác khỏi Quỹ hàng vẫn có thể bị đưa vào một link chia sẻ mới, và khách mở link cũ vẫn bấm được «Quan tâm» dù trang đã báo căn không còn.\",\"can_cu\":\"Hậu quả vừa phải: không mất hay lộ dữ liệu nhưng có thể sinh liên hệ khách cho căn đã gỡ; người dùng không tự gỡ được và sửa ở tầng dữ liệu cần migration riêng.\",\"proposal\":\"new-contract\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/api/src/public/store.ts\",\"title\":\"The voided-to-Withdrawn rule for the customer page lives in the API store, not in the core redaction rule\",\"severity\":\"medium\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Hiện trang khách vẫn báo căn đã gỡ là không còn; rủi ro là một cửa ra khác trong tương lai có thể quên luật này và để lộ giá của căn đã gỡ.\",\"can_cu\":\"Hiện không ai thấy sai ở trang khách, rủi ro chỉ phát sinh khi thêm cửa ra mới và sửa lúc đó rẻ hơn.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/undo/routes.ts\",\"title\":\"The undo route turns every exception into `import-undo-incomplete` (503)\",\"severity\":\"low\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Nếu hoàn tác gặp lỗi thật chứ không phải đứt mạng, người dùng vẫn chỉ thấy «bấm lại để làm tiếp» và bấm mãi không xong, đội kỹ thuật không có dấu vết để tìm nguyên nhân.\",\"can_cu\":\"Không mất dữ liệu và các căn đã làm xong được giữ, nhưng người dùng bị kẹt không tự gỡ được khi lỗi lặp lại.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/db/migrations/025_hoan_tac_nhap.sql\",\"title\":\"Migration number 025 is placed after 026–033 already on main\",\"severity\":\"low\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Thứ tự áp dụng thay đổi dữ liệu có thể khác nhau giữa môi trường cũ và môi trường mới, nhưng hiện chưa gây sai lệch nào cho người dùng.\",\"can_cu\":\"Số đã được giữ có chủ đích, các thay đổi không đụng nhau nên người dùng không thấy gì; đổi số sau khi đã áp dụng lại gây rối hơn.\",\"proposal\":\"wont-fix\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/undo/store.ts\",\"title\":\"Hoàn tác nuốt mọi lỗi, không ghi log: lỗi lặp lại thành vòng «chưa xong, bấm lại» mãi mãi mà không ai biết nguyên nhân\",\"severity\":\"medium\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Khi một dòng luôn hỏng, người dùng thấy «Hoàn tác chưa xong» mãi và bấm lại không giúp được, còn đội kỹ thuật không biết vì sao.\",\"can_cu\":\"Dữ liệu không bị mất hay lộ nhưng lần nhập có thể không bao giờ hoàn tác xong; sửa bằng ghi nhật ký khá rẻ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/api/src/imports/undo/store.ts\",\"title\":\"Mọi lần từ chối của lệnh bù đều bị ghi là «Đã có người sửa sau lần nhập»\",\"severity\":\"low\",\"source\":\"bugs\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Một số căn không hoàn tác được vì lý do khác sẽ bị báo nhầm là «Đã có người sửa sau lần nhập» và không được thử lại.\",\"can_cu\":\"Chỉ sai lý do hiển thị ở các tình huống hiếm, căn không bị gỡ nhầm và không mất dữ liệu; người dùng tự xử lý tay được.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"apps/web/src/lib/nhap/hoan-tac.ts\",\"title\":\"Xem thử thất bại vẫn bật nút ghi: bấm «Hoàn tác tiếp» là hoàn tác thật khi người dùng chưa xem trước\",\"severity\":\"medium\",\"source\":\"bugs\",\"inContract\":true,\"acRef\":\"AC-5\",\"plain\":\"\",\"can_cu\":\"\",\"proposal\":\"\",\"khongBacBo\":false,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"packages/api/test-db/imports/hoan-tac.test.ts\",\"title\":\"Hình dạng 3 — chỉ kiểm «chuỗi có mặt» trong khi lời hứa là quan hệ căn đã gỡ ↔ trạng thái «unavailable» và không giá\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Bài kiểm có thể vẫn xanh dù căn đã gỡ lại hiện giá trên trang khách; sản phẩm hiện chưa thấy sai.\",\"can_cu\":\"Không ảnh hưởng người dùng trực tiếp, chỉ làm giảm độ tin của bài kiểm; siết lại sau rẻ và không rủi ro dữ liệu.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-05T01:49:05Z\",\"sha\":\"76349a4789b4007fc818b3fbe42e80cd6eb07671\",\"round\":1,\"kind\":\"finding\",\"file\":\"apps/web/src/lib/nhap/hoan-tac.test.ts\",\"title\":\"Hình dạng 4 — kiểm âm tính một mình: «huỷ thì không ghi» không có đối chứng dương, và đường huỷ không hề được chạy\",\"severity\":\"medium\",\"source\":\"measurement\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Bài kiểm «huỷ thì không ghi gì» chưa thực sự thử đường huỷ nên nếu có lỗi ghi khi huỷ thì không bị bắt.\",\"can_cu\":\"Hiện chưa thấy lỗi ở sản phẩm; rủi ro là lỗi tương lai lọt qua, và bổ sung bài kiểm sau rẻ.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
