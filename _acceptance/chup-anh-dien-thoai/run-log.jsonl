"{\"ts\":\"2026-11-05T23:51:54Z\",\"sha\":\"b2323a50626791a0f7262183909a0138740efea3\",\"round\":1,\"kind\":\"finding\",\"file\":\"apps/web/src/app/(app)/units/photos/hang-cho-anh.ts\",\"title\":\"Hàng chờ ảnh không gắn sàn: ảnh chụp ở sàn A có thể được tải vào căn trùng toà/mã của sàn B\",\"severity\":\"high\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Người làm ở hai sàn có thể chụp ảnh lúc mất mạng ở sàn này, đổi sang sàn kia, rồi ảnh (kể cả ảnh sổ đỏ) tự lên căn trùng toà và mã của sàn kia.\",\"can_cu\":\"Nặng vì ảnh nội bộ có thể sang sàn khác và không gỡ lại được, nhưng chỉ xảy ra với người thuộc nhiều sàn và hợp đồng này chưa nói tới trường hợp đó nên cần tính năng riêng.\",\"proposal\":\"new-contract\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
