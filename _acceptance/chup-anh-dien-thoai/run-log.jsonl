"{\"ts\":\"2026-11-06T04:32:49Z\",\"sha\":\"145215dc62926618cb084dc1d94dd2db8557d750\",\"round\":2,\"kind\":\"finding\",\"file\":\"apps/web/src/app/(app)/units/photos/hang-cho-anh.ts\",\"title\":\"Đăng xuất phải chờ hết lượt tải ảnh đang chạy vì lượt tải không bị huỷ, nên có thể treo lâu\",\"severity\":\"medium\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Khi mạng yếu và đang tải ảnh lớn, bấm Đăng xuất có thể đứng chờ khá lâu trước khi xong. Cuối cùng ảnh chờ vẫn bị xoá.\",\"can_cu\":\"Chỉ làm chậm chứ không làm mất hay lộ dữ liệu, người dùng chờ hoặc tải lại là xong, và sửa cần thêm cơ chế huỷ lượt tải khá tốn công.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
"{\"ts\":\"2026-11-06T04:32:49Z\",\"sha\":\"145215dc62926618cb084dc1d94dd2db8557d750\",\"round\":2,\"kind\":\"finding\",\"file\":\"apps/web/src/app/(app)/units/photos/hang-cho-anh.ts\",\"title\":\"Một lần xoá hay ghi kho bị lỗi làm cờ «kho lỗi» bật mãi, ngăn chụp báo «Máy không giữ được ảnh chờ» cả khi đáng lẽ không báo\",\"severity\":\"low\",\"source\":\"conventions\",\"inContract\":false,\"acRef\":\"\",\"plain\":\"Sau một lần lỗi nhỏ khi dọn kho, ngăn chụp có thể báo sai rằng máy không giữ được ảnh chờ cho tới khi tải lại trang.\",\"can_cu\":\"Chỉ là lời báo sai gây lo, không mất ảnh nào, và người dùng tự hết báo bằng cách tải lại trang.\",\"proposal\":\"known-limits\",\"khongBacBo\":true,\"unverified\":false,\"unclassified\":false}"
